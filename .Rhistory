scale_fill_manual(values = color_trophic$color[match(levels(mediators_E$taxon), color_trophic$taxon)]) +
labs(x = "Trophic guild",
y = "Percentage of indirect effects on NCP\nmediated by trophic guilds (Extensive)",
fill = "Trophic guild") +
theme(panel.background = element_rect(fill = "white"),
